RUNBOAT_REPOS=[{"repo":"^zvERP/.*","branch":"^18.0$","builds":[{"image":"ghcr.io/oca/oca-ci/py3.10-odoo18.0:latest"}]}]
RUNBOAT_API_ADMIN_USER=admin
RUNBOAT_API_ADMIN_PASSWD=change-me
RUNBOAT_BUILD_NAMESPACE=runboat
RUNBOAT_BUILD_DOMAIN=runboat.zverp.com
RUNBOAT_BUILD_SCHEME=https
RUNBOAT_BUILD_INGRESS_CLASS_NAME=nginx
RUNBOAT_BUILD_TLS_SECRET_NAME=wildcard-runboat-tls
RUNBOAT_BUILD_ENV={"PGHOST":"postgres.runboat-builds-db.svc.cluster.local","PGPORT":"5432","PGUSER":"runboat-build"}
RUNBOAT_BUILD_SECRET_ENV={"PGPASSWORD":"same-as-postgres.env"}
RUNBOAT_BUILD_TEMPLATE_VARS={"storageClassName":"longhorn-runboat"}
RUNBOAT_GITHUB_TOKEN=
RUNBOAT_GITHUB_WEBHOOK_SECRET=
RUNBOAT_BASE_URL=https://runboat.zverp.com
RUNBOAT_ADDITIONAL_FOOTER_HTML=
